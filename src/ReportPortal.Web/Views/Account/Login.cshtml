@model ReportPortal.Web.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Sign in";
    ViewBag.BodyClass = "login-page";
}

<section class="login-grid">
    <div class="login-copy">
        <img class="hero-logo" src="@Url.Content("~/Content/images/dib-logo.svg")" alt="Dubai Islamic Bank" />
        <span class="portal-label">Enterprise Report Portal</span>
        <h1>Secure access to operational reports.</h1>
        <p>Sign in with your Windows user ID. Access is checked against the portal authorization tables before applications or reports are shown.</p>
    </div>
    <div class="access-card">
        <span class="eyebrow">Secure access</span>
        <h2>Sign in</h2>
        <p class="card-help">Use your Active Directory user ID, for example <strong>DOMAIN\user.id</strong>.</p>
        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation" })
            <div class="form-group">
                @Html.LabelFor(m => m.WindowsUserId)
                @Html.TextBoxFor(m => m.WindowsUserId, new { @class = "form-control", placeholder = "DOMAIN\\Harsh.V", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.WindowsUserId, "", new { @class = "field-validation" })
            </div>
            <label class="check-row">
                @Html.CheckBoxFor(m => m.KeepMeSignedIn)
                <span>Keep me signed in on this machine</span>
            </label>
            <button class="btn btn-primary btn-block" type="submit">Sign in</button>
        }
    </div>
</section>